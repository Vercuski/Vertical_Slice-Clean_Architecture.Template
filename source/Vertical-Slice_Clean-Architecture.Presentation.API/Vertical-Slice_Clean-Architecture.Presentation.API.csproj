<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Vertical_Slice_Clean_Architecture.Presentation.API</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <!--#if (HasEfCore) -->
    <!-- Lets `dotnet ef` use this project as the startup project for migrations (see CommandDbContext). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!--#endif -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vertical-Slice_Clean-Architecture.Domain\Vertical-Slice_Clean-Architecture.Domain.csproj" />
    <ProjectReference Include="..\Vertical-Slice_Clean-Architecture.Infrastructure\Vertical-Slice_Clean-Architecture.Infrastructure.csproj" />
  </ItemGroup>

</Project>
