{
  "ConnectionStrings": {
    // Read (query) and write (command) databases. Both may point at the same database; split them
    // when reads should go to a replica. Keep real credentials out of this file (user secrets or
    // environment variables, e.g. ConnectionStrings__CommandDbConnection).
//#if (HasPostgreSql)
//~    "QueryDbConnection": "Host=localhost;Port=5432;Database=sample;Username=postgres;Password=<password>",
//~    "CommandDbConnection": "Host=localhost;Port=5432;Database=sample;Username=postgres;Password=<password>"
//#elseif (HasMySql)
//~    "QueryDbConnection": "Server=localhost;Port=3306;Database=sample;User ID=root;Password=<password>",
//~    "CommandDbConnection": "Server=localhost;Port=3306;Database=sample;User ID=root;Password=<password>"
//#else
    "QueryDbConnection": "Server=localhost;Database=Sample;Trusted_Connection=True;Encrypt=True;TrustServerCertificate=True",
    "CommandDbConnection": "Server=localhost;Database=Sample;Trusted_Connection=True;Encrypt=True;TrustServerCertificate=True"
//#endif
  },
//#if (HasMySql && HasEfCore)
  "Database": {
    // MySQL or MariaDB server version EF Core generates SQL for, e.g. 8.4.0-mysql or 11.4.2-mariadb.
    "MySqlServerVersion": "8.4.0-mysql"
  },
//#endif
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    // One JSON object per log entry on stdout, for container log collectors. Scopes carry the
    // request's CorrelationId. appsettings.Development.json switches to the readable "simple" format.
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "AllowedHosts": "*"
}
