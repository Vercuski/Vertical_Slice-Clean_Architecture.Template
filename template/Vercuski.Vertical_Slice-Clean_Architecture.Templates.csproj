<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Packs source/ (including source/.template.config) as a `dotnet new` template package.
      dotnet pack template/Vercuski.Vertical_Slice-Clean_Architecture.Templates.csproj -c Release -o artifacts
      dotnet new install artifacts/Vercuski.Vertical_Slice-Clean_Architecture.Templates.<version>.nupkg
      dotnet new vsca -n MyCompany.MyProduct
    Installed template packages also appear in Visual Studio's New Project dialog.
    Drop_and_Recreate_Template.ps1 (repository root) runs this uninstall / pack / install cycle locally.

    The package version comes from MinVer, configured in source/Directory.Build.props and imported
    through template/Directory.Build.props, so the template and the solution share one Semantic Version.
  -->

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>Vercuski.Vertical_Slice-Clean_Architecture.Templates</PackageId>
    <Title>Vertical Slice + Clean Architecture Solution Template</Title>
    <Authors>Scott Vercuski</Authors>
    <Description>A .NET 10 Minimal API solution template that organizes features as vertical slices (request, validator, handler and endpoint in one file) on top of Clean Architecture Domain and Infrastructure layers. Choose EF Core or Dapper on SQL Server, PostgreSQL or MySQL; includes FluentValidation, health checks, correlation IDs, structured logging and a Testcontainers-backed test project.</Description>
    <PackageTags>dotnet-new;templates;vertical-slice-architecture;clean-architecture;minimal-api;ef-core;dapper;sql-server;postgresql;mysql</PackageTags>
    <PackageProjectUrl>https://github.com/Vercuski/Vertical_Slice-Clean_Architecture.Template</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Vercuski/Vertical_Slice-Clean_Architecture.Template</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- The same icon Visual Studio shows in the New Project dialog (source/.template.config/ide.host.json). -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- Keep dot-files and dot-folders (.template.config, .dockerignore) that pack skips by default. -->
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <!-- NU5128: no lib/ folder is expected for a content-only template package. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\source\**\*"
             Exclude="..\source\**\bin\**;..\source\**\obj\**;..\source\**\.vs\**;..\source\**\*.user;..\source\**\TestResults\**"
             PackagePath="content" />
    <None Include="..\source\.template.config\icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <Compile Remove="**\*" />
  </ItemGroup>

</Project>
